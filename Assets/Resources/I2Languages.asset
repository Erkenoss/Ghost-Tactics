    - Term: Dialogue Level 5/L05E_038
      TermType: 0
      Description: 
      Languages:
      - 'Something flashes behind your eyes.

        Not an image. A memory.'
      - 'Quelque chose traverse ton esprit.

        Pas une image. Un souvenir.'
      - 
      - 
      Flags: 00000000
      Languages_Touch: []
    - Term: Dialogue Level 5/L05E_039
      TermType: 0
      Description: 
      Languages:
      - "Wait\u2014"
